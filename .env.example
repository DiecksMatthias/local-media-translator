# Copy to .env and fill in. .env is gitignored; never commit real values.

# Host uid/gid the container runs as - output files land with this ownership.
LMT_UID=1000
LMT_GID=1000

# Existing Docker network to attach to (so container-name endpoints like
# http://stash:9999/graphql resolve). Required: it must already exist, compose
# will not create it. Use the network your media server's container is on,
# or any existing network name.
LMT_NETWORK=homelab

# Host directory mounted at /media inside the container.
LMT_MEDIA_DIR=/path/to/your/media

# Endpoints. These are passed straight into the container's environment;
# the double underscore separates config sections from keys.
Transcription__ServerModel=Systran/faster-whisper-large-v3
Transcription__Endpoint=http://your-whisper-host:8000
Translation__Endpoint=http://your-llm-host:11434
MediaServer__Endpoint=http://your-media-server:9999/graphql
MediaServer__ApiKey=replace-me

# The image seeds /config/appsettings.local.json with the /data -> /media path
# mapping, so no first-run setup is needed. If your media server uses a
# different path prefix, override it once:
#   docker compose run --rm cli set MediaServer:PathMappings:<prefix> /media
